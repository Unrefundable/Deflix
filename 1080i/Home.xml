<?xml version="1.0" encoding="utf-8"?>
<!-- BINGIE -->
<window>
    <defaultcontrol always="true">1000</defaultcontrol>
    <menucontrol>900</menucontrol>

    <!-- Defaults -->
    <include>DefaultSkinSettings</include>
    
	<!-- BINGIE -->
    <onload condition="!String.IsEmpty(Skin.String(CustomSearchTerm))">Skin.Reset(CustomSearchTerm)</onload>
    <!-- Skin.Set* saves settings to disk, so only call it when the value differs -->
    <onload condition="!String.IsEqual(Skin.String(TMDbBingieHelper.MonitorContainer),17195)">Skin.SetString(TMDbBingieHelper.MonitorContainer,17195)</onload>
	<onload condition="!Skin.HasSetting(EnableRatings) + !Skin.HasSetting(TMDbBingieHelper.DisableRatings)">Skin.SetBool(TMDbBingieHelper.DisableRatings)</onload>
    <onload condition="Skin.HasSetting(EnableRatings) + Skin.HasSetting(TMDbBingieHelper.DisableRatings)">Skin.Reset(TMDbBingieHelper.DisableRatings)</onload>
    <onload condition="!Skin.HasSetting(TMDbBingieHelper.DisablePVR)">Skin.SetBool(TMDbBingieHelper.DisablePVR)</onload>

	<!-- Build Menu: once per boot; leaving Skin Settings rebuilds after edits.
	     A skin update deletes the generated menu file, which leaves the main
	     menu (900) empty, so rebuild then too. -->
    <onload condition="String.IsEmpty(Window(Home).Property(DeflixMenusBuilt)) | Integer.IsEqual(Container(900).NumItems,0)">RunScript(script.skinshortcuts,type=buildxml&amp;mainmenuID=900&amp;levels=1&amp;group=mainmenu|powermenu|searchmenu|tmdbsearchmenu|moviehub|tvshowhub|newhub|customhub|somethinghub|mylisthub)</onload>
    <onload>SetProperty(DeflixMenusBuilt,1,Home)</onload>
    <onload condition="String.IsEmpty(Window(Home).Property(widgetstyle))">SetProperty(widgetstyle,$INFO[Skin.String(widgetstyle)])</onload>
	<onload>Skin.TimerStart(spotlightanimation)</onload>

    <!-- First Run -->
	<onload condition="$EXP[IsFirstRun]">ReplaceWindow($VAR[StartUpWindow])</onload>
    <onunload>SetProperty(SectionBackground,$ESCINFO[Control.GetLabel(99004)])</onunload>
    <onunload condition="System.HasAlarm(preview_delay)">CancelAlarm(preview_delay,silent)</onunload>
    <onunload>ClearProperty(submenu,Home)</onunload>
    <onunload>ClearProperty(ShowViewSubMenu,Home)</onunload>
    <include>BingieViews_WindowOpen_Fade</include>

	<controls>
		<include>Defs_TMDbBingieHelper_Loader</include>
		<!-- Global Background -->
        <include>GlobalBackground</include>     
        <control type="button" id="1000">
            <include>HiddenObject</include>
            <onfocus condition="String.IsEmpty(Window(Home).Property(LastFocusWidget))">SetFocus(77777)</onfocus>
            <onfocus condition="String.IsEmpty(Window(Home).Property(HomeFirstLoadDone))">SetProperty(HomeFirstLoadDone,1)</onfocus>
            <onleft>900</onleft>
            <onright>900</onright>
            <onback>900</onback>
        </control>

        <!-- Preload Weather Conditions -->
        <control type="label">
            <label>$INFO[Weather.Conditions]</label>
            <include>HiddenObject</include>
        </control>

        <!-- Preload submenu for count calculations -->
        <include condition="!Skin.HasSetting(DisableAllSubmenus)">hiddenSubmenu</include>    
	
		<!-- Home Screen -->
        <include>HomeBingie</include>

		<!-- Debug -->
        <include condition="Skin.HasSetting(DebugGrid) | Skin.HasSetting(DebugInfo)">DebugInfo</include>
	</controls>
</window>
