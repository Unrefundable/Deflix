<?xml version="1.0" encoding="utf-8"?>
<!-- DEFLIX -->
<includes>

	<!-- Provider themes.
	     Each provider hub sets Window(Home).Property(DeflixProvider) to prime, netflix, apple,
	     disney, hbo, paramount or crunchyroll (Home and Search clear it). These variables swap the accent and surface
	     colours while it is set and otherwise return the user's own colour setting, so the
	     default look is unchanged. Netflix keeps the user's accent colours (red by default)
	     and only changes the surfaces. -->

	<variable name="Theme_ActiveSpinControlColor">
		<value condition="String.IsEqual(Window(Home).Property(DeflixProvider),prime)">ff1a98ff</value>
		<value condition="String.IsEqual(Window(Home).Property(DeflixProvider),disney)">ff0063e5</value>
		<value condition="String.IsEqual(Window(Home).Property(DeflixProvider),apple)">ffffffff</value>
		<value condition="String.IsEqual(Window(Home).Property(DeflixProvider),hbo)">ff7b2ff7</value>
		<value condition="String.IsEqual(Window(Home).Property(DeflixProvider),paramount)">ff0064ff</value>
		<value condition="String.IsEqual(Window(Home).Property(DeflixProvider),crunchyroll)">fff47521</value>
		<value>$INFO[Skin.String(ActiveSpinControlColor)]</value>
	</variable>

