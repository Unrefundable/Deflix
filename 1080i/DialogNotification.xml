<?xml version="1.0" encoding="utf-8"?>
<!-- BINGIE -->
<window>
    <zorder>3</zorder>
    <controls>
        <!-- Compact streaming-service style toast -->
        <control type="group">
            <depth>0.54</depth>
            <top>42</top>
            <right>34</right>
            <width>720</width>
            <height>142</height>
            <animation type="WindowOpen" reversible="false">
                <effect type="slide" start="80" end="0" tween="cubic" easing="out" time="320" />
                <effect type="fade" start="0" end="100" tween="cubic" easing="out" time="220" />
            </animation>
            <animation type="WindowClose" reversible="false">
                <effect type="slide" start="0" end="80" tween="cubic" easing="out" time="260" />
                <effect type="fade" start="100" end="0" tween="cubic" easing="out" time="260" />
            </animation>
            <visible>!Window.IsVisible(startup)</visible>
            <!-- panel bg -->
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>720</width>
                <height>142</height>
                <texture colordiffuse="e6101010">diffuse/panel-spot.png</texture>
                <bordersize>14</bordersize>
            </control>
            <control type="image" id="400">
                <description>avatar</description>
                <left>24</left>
                <top>31</top>
                <width>56</width>
                <height>56</height>
                <aspectratio>keep</aspectratio>
            </control>

            <control type="label" id="401">
                <description>Line 1 Label</description>
                <left>98</left>
                <top>20</top>
                <width>590</width>
                <height>34</height>
                <font>Bold24</font>
                <textcolor>FFFFFFFF</textcolor>
                <shadowcolor>AA000000</shadowcolor>
                <aligny>center</aligny>
            </control>
            <control type="label" id="402">
                <description>Line 2 Label</description>
                <left>98</left>
                <top>57</top>
                <width>590</width>
                <height>70</height>
                <font>Reg24</font>
                <textcolor>FFFFFFFF</textcolor>
                <shadowcolor>AA000000</shadowcolor>
                <aligny>top</aligny>
                <wrapmultiline>true</wrapmultiline>
            </control>
        </control>
	</controls>
</window>
